# =============================================================================
# MEI Nota Fácil — Sistema Comercial de IA
# MODELO de variáveis de ambiente. Copie para `.env` e preencha localmente.
#
# ATENÇÃO: este arquivo é versionado. NUNCA preencha valores reais aqui.
# O `.env` real vive apenas no servidor, no cofre de segredos ou nas
# credenciais do n8n. Ver SECURITY.md e docs/commercial-ai/09-seguranca.md.
# =============================================================================

# ─── Aplicação ──────────────────────────────────────────────────────────────
# development | staging | production
APP_ENV=development
APP_BASE_URL=
# Nome do responsável de plantão exibido em alertas operacionais
OPS_CONTACT=

# ─── Inteligência artificial ────────────────────────────────────────────────
# Provedor ativo. O SaaS principal já usa "gemini" (free tier) com fallback
# determinístico; mantemos a mesma abstração aqui. Ver docs/commercial-ai/11-custos.md
AI_PROVIDER=gemini
AI_FALLBACK_PROVIDER=
# Modelo econômico: classificação, extração, intenção, resumo curto
AI_MODEL_SIMPLE=
# Modelo avançado: objeção complexa, análise estratégica, conversa longa
AI_MODEL_ADVANCED=
# Tetos de custo em USD. Ao atingir, o roteador para de chamar IA e cai
# para respostas determinísticas por template (ver config/costs/ai-cost-limits.json)
AI_MAX_COST_DAILY=
AI_MAX_COST_MONTHLY=

ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ─── HubSpot (CRM) ──────────────────────────────────────────────────────────
# Private App token. Escopos mínimos em docs/commercial-ai/05-hubspot.md
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_PORTAL_ID=

# ─── WhatsApp Business Cloud API (oficial da Meta) ──────────────────────────
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Token arbitrário usado no handshake GET de verificação do webhook
WHATSAPP_VERIFY_TOKEN=
# App Secret — usado para validar o header X-Hub-Signature-256 de cada POST
WHATSAPP_APP_SECRET=
# Versão da Graph API fixada (evita quebra silenciosa em upgrade da Meta)
WHATSAPP_GRAPH_VERSION=

# ─── n8n (orquestrador) ─────────────────────────────────────────────────────
N8N_BASE_URL=
N8N_API_KEY=
# Segredo compartilhado que assina as chamadas entre este sistema e o n8n
N8N_WEBHOOK_SECRET=

# ─── SaaS MEI Nota Fácil (repositório mei-facil) ────────────────────────────
# URL base da API do SaaS. Somente endpoints autenticados — este sistema NÃO
# acessa o banco de produção do SaaS diretamente (ver ADR-005).
SAAS_API_BASE_URL=
SAAS_API_TOKEN=
# Segredo HMAC compartilhado que assina os eventos enviados pelo SaaS
WEBHOOK_SIGNING_SECRET=

# ─── Armazenamento próprio do sistema comercial ─────────────────────────────
# Banco separado do banco operacional do SaaS
DATABASE_URL=
REDIS_URL=

# ─── E-mail ─────────────────────────────────────────────────────────────────
# hubspot | smtp | none — ver docs/commercial-ai/08-email.md
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# ─── Criptografia e segurança ───────────────────────────────────────────────
# Chave de 32 bytes em base64 para dados sensíveis em repouso
ENCRYPTION_KEY=

# ─── Interruptor de emergência ──────────────────────────────────────────────
# "true" congela TODO envio de mensagem automatizada sem precisar de deploy.
# Ver docs/commercial-ai/13-operacao.md (botão de parada).
COMMERCIAL_AI_KILL_SWITCH=false
